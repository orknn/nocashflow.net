# NoCashFlow — environment template. Copy to .env and fill in locally.
# .env is gitignored; never commit real values.

# ── data pipeline (GitHub Actions secrets, scripts/*.py) ─────────────────────
FINNHUB_API_KEY=            # economic calendar (scripts/fetch_data.py)
ALPHAVANTAGE_API_KEY=       # optional news supplement (scripts/fetch_news.py)

# ── market API Worker (workers/market) ──────────────────────────────────────
# Both current providers (Yahoo, CoinGecko/Kraken) are keyless, so no secret is
# needed today. When a licensed feed is added, set it as a Worker secret —
# never in this repo and never in front-end JavaScript:
#   cd workers/market && npx wrangler secret put MARKET_API_KEY
MARKET_API_KEY=

# ── subscription Worker (workers/) ──────────────────────────────────────────
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put ADMIN_TOKEN
RESEND_API_KEY=
ADMIN_TOKEN=
